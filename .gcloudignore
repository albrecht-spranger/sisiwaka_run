# まず .gitignore と同等を読ませる
.gcloudignore
.git
.gitignore

# ==============================
# 機密・環境変数ファイル（必須）
# ==============================
.env
.env.*
*.key
*.pem

# ローカル生成物
node_modules
npm-debug.log
*.log
dist/
tmp/
.cache/
coverage/

# Docker 関連（Buildpacks方式では不要）
Dockerfile
docker/
.dockerignore

# ==============================
# ドキュメント・ツール類（本番ランタイム不要）
# ==============================
README*
readme.txt
*.md
docs/
firestore_import/
tests/
src/   # 中身が開発専用の場合のみ除外
firestore_import/
correct_video_url/
